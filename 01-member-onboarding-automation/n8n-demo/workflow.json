    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  const contactRef = String(data.applicant.contact_ref).trim().toLowerCase();\n  return {\n    json: {\n      ...data,\n      applicant: { ...data.applicant, contact_ref: contactRef },\n      idempotency_key: `${data.application_id}:${contactRef}`,\n      normalized_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "11111111-1111-4111-8111-111111111113",
      "name": "Normalize + Idempotency Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "prior-status-check",
              "leftValue": "={{$json.prior_status}}",
              "rightValue": "duplicate",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "11111111-1111-4111-8111-111111111114",
      "name": "Duplicate / Prior Status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
