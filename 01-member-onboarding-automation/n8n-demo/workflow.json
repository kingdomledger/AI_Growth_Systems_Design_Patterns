    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n  const contactRef = String(data.applicant.contact_ref || '').trim().toLowerCase();\n  return {\n    json: {\n      ...data,\n      applicant: { ...data.applicant, contact_ref: contactRef },\n      duplicate_key: `${contactRef}:${data.requested_access}`,\n      idempotency_key: `${data.application_id}:${contactRef}`,\n      normalized_at: new Date().toISOString()\n    }\n  };\n});"
      },
