    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const decision = item.json.admin_override ? 'admin_override' : item.json.review_decision;\n  const routes = {\n    approve: 'grant_access',\n    reject: 'deny_access',\n    revoke: 'revoke_access',\n    admin_override: 'operator_override'\n  };\n  return { json: { ...item.json, decision, provisioning_action: routes[decision] || 'needs_review' } };\n});"
      },
