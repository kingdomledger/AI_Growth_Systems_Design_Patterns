    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"queue_id\": 1001,\n  \"source_platform\": \"example_source\",\n  \"source_item_id\": \"source_item_001\",\n  \"profile_url\": \"https://social.example/example_creator?ref=demo\",\n  \"handle\": \"@Example_Creator\",\n  \"display_name\": \"Example Creator\",\n  \"bio_summary\": \"Builds public tutorials about AI operations and workflow automation.\",\n  \"scenario\": {\n    \"has_strong_identifier\": true,\n    \"registry_match_count\": 1,\n    \"candidate_uuids\": [\"lead_uuid_001\"],\n    \"human_review_status\": \"approved\",\n    \"already_exported\": false\n  }\n}",
        "options": {}
      },
      "id": "a4fa7173-f03f-4582-9eab-d8f7cae0f854",
      "name": "Mock SQL Source Queue Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        416,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "function normalizeHandle(value) {\n  return value ? String(value).trim().replace(/^@+/, '').toLowerCase() : null;\n}\n\nfunction normalizeProfileUrl(value) {\n  if (!value) return null;\n  try {\n    const url = new URL(String(value).trim());\n    url.hash = '';\n    url.search = '';\n    url.pathname = url.pathname.replace(/\\/+$/, '') || '/';\n    return url.toString().replace(/\\/$/, '');\n  } catch {\n    return null;\n  }\n}\n\nreturn items.map(item => {\n  const profileUrlNorm = normalizeProfileUrl(item.json.profile_url);\n  const handleNorm = normalizeHandle(item.json.handle);\n  const strongIdentifiers = [\n    profileUrlNorm ? { type: 'profile_url', value: profileUrlNorm, strength: 'strong' } : null,\n    handleNorm ? { type: 'platform_handle', value: handleNorm, strength: 'strong' } : null,\n  ].filter(Boolean);\n\n  return {\n    json: {\n      ...item.json,\n      identity: {\n        profile_url_norm: profileUrlNorm,\n        handle_norm: handleNorm,\n        strong_identifiers: strongIdentifiers,\n        weak_attributes: {\n          display_name: item.json.display_name,\n          bio_summary: item.json.bio_summary,\n        },\n        has_strong_identifier: strongIdentifiers.length > 0,\n      }\n    }\n  };\n});"
      },
      "id": "9e974f12-1d38-4173-be81-94a1c42061ec",
      "name": "Normalize Identifier Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        592
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "has-strong-identifier",
              "leftValue": "={{$json.identity.has_strong_identifier}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "299efb87-e606-4808-954e-0ec58e1e7138",
      "name": "Has Strong Identifier?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        912,
        592
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"queue_id\": {{$json.queue_id}},\n  \"source_queue_status\": \"skipped\",\n  \"reason\": \"No usable strong identifier\",\n  \"operator_action\": \"repair_source_record\"\n}",
        "options": {}
      },
      "id": "c7ab8ba2-c112-42d6-bee6-faa588c094f2",
      "name": "Skipped / Source Repair",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1168,
        736
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const matchCount = item.json.scenario?.registry_match_count ?? 0;\n  const candidateUuids = item.json.scenario?.candidate_uuids ?? [];\n\n  return {\n    json: {\n      ...item.json,\n      identity: {\n        ...item.json.identity,\n        registry_match_count: matchCount,\n        candidate_uuids: candidateUuids,\n        resolution_status: matchCount === 0\n          ? 'no_match'\n          : matchCount === 1\n            ? 'single_uuid_match'\n            : 'multiple_uuid_conflict',\n      }\n    }\n  };\n});"
      },
      "id": "be9a7f6c-cbb8-48c0-8e6a-62434bda745e",
      "name": "Mock SQL Identity Registry Lookup",
