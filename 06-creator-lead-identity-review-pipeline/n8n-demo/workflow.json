        "jsonOutput": "={\n  \"uuid\": \"{{$json.canonical_uuid}}\",\n  \"profile_url_norm\": \"{{$json.identity.profile_url_norm}}\",\n  \"handle_norm\": \"{{$json.identity.handle_norm}}\",\n  \"public_signals\": {\n    \"category\": \"workflow automation\",\n    \"bio_summary\": \"Builds public tutorials about AI operations.\"\n  },\n  \"source_queue_status\": \"{{$json.source_queue_status}}\",\n  \"identity_resolution\": \"{{$json.identity_resolution}}\",\n  \"registry_records_written\": {{$json.registry_records_written}},\n  \"conflict_records_written\": {{$json.conflict_records_written}},\n  \"scenario\": {\n    \"human_review_status\": \"approved\",\n    \"already_exported\": false\n  }\n}",
        "options": {}
      },
      "id": "269d8cdf-2cb2-4759-a2a6-0483f12d070b",
      "name": "Prepare Enrichment Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2336,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const signals = `${item.json.public_signals?.category || ''} ${item.json.public_signals?.bio_summary || ''}`.toLowerCase();\n  const strongSignal = /workflow|automation|operations|ops/.test(signals);\n\n  return {\n    json: {\n      ...item.json,\n      enrichment: {\n        status: 'drafted',\n        contract_version: 'public-demo-v1',\n        fit_tier: strongSignal ? 'high' : 'review',\n        confidence: strongSignal ? 0.87 : 0.54,\n        summary: strongSignal\n          ? 'Strong public workflow-automation signal.'\n          : 'Needs operator review before qualification.',\n        recommended_action: strongSignal ? 'review_for_export' : 'hold_for_review',\n        human_review_status: item.json.scenario?.human_review_status || 'pending',\n      }\n    }\n  };\n});"
      },
      "id": "4d73f6a0-a45a-4494-97d9-8a6ba399a80c",
      "name": "Local Enrichment API Adapter Mock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2528,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const enrichment = item.json.enrichment || {};\n  const valid = Boolean(item.json.uuid && enrichment.fit_tier && typeof enrichment.confidence === 'number');\n\n  return {\n    json: {\n      ...item.json,\n      enrichment_validation: valid ? 'valid' : 'needs_review',\n      human_review_status: enrichment.human_review_status || 'pending',\n    }\n  };\n});"
      },
      "id": "4a285502-ccc1-45e9-b4ac-44cb6e1e554c",
      "name": "Validate Enrichment Response",
