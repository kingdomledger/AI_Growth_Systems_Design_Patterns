    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json.lead || {};\n  const displayName = String(lead.display_name || '').trim();\n  const sourceRef = String(lead.source_ref || 'unknown_source').trim();\n  const dedupeKey = `${sourceRef}:${displayName}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n  return {\n    json: {\n      ...item.json,\n      lead_id: 'lead_001',\n      lead: {\n        ...lead,\n        display_name: displayName,\n        contact_ref: lead.contact_ref || null\n      },\n      dedupe_key: dedupeKey,\n      idempotency_key: `lead_001:${dedupeKey}`,\n      normalized_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "65059838-5b79-498a-8242-365ccec4e2ee",
      "name": "Normalize + Idempotency Key",
