      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1020, 500]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const summary = item.json.lead.profile_summary || '';\n  const sourceCount = item.json.enrichment.source_count || 0;\n  const confidence = summary.length > 20 && sourceCount >= 2 ? 0.86 : 0.52;\n  const fitTier = confidence >= 0.8 ? 'high' : 'review';\n  return {\n    json: {\n      ...item.json,\n      ai_review: {\n        fit_category: 'workflow_operator',\n        fit_tier: fitTier,\n        confidence,\n        reason_codes: ['ops_systems_signal', 'public_content_match'],\n        note: 'Example AI-analysis note for operator review.'\n      }\n    }\n  };\n});"
      },
