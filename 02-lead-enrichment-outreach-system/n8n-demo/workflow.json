    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"batch_id\": \"lead_batch_001\",\n  \"lead\": {\n    \"source_ref\": \"public_directory\",\n    \"display_name\": \"Example Operator\",\n    \"profile_summary\": \"Runs a public newsletter about operations systems.\",\n    \"category_hint\": \"automation_operator\",\n    \"contact_ref\": \"contact_ref_001\"\n  },\n  \"existing_record\": false,\n  \"review_status\": \"approved\",\n  \"rerun_requested\": false,\n  \"cancel_before_handoff\": false\n}"
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Lead Intake Example",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 360]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json.lead || {};\n  const displayName = String(lead.display_name || '').trim();\n  const sourceRef = String(lead.source_ref || 'unknown_source').trim();\n  const dedupeKey = `${sourceRef}:${displayName}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\n  return {\n    json: {\n      ...item.json,\n      lead_id: 'lead_001',\n      lead: {\n        ...lead,\n        display_name: displayName,\n        contact_ref: lead.contact_ref || null\n      },\n      dedupe_key: dedupeKey,\n      idempotency_key: `lead_001:${dedupeKey}`,\n      normalized_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "22222222-2222-4222-8222-222222222223",
      "name": "Normalize + Dedupe Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 360]
    },
    {
      "parameters": {
