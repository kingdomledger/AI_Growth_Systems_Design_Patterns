    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const data = item.json;\n  const missing = ['event_id', 'event_type', 'record_id', 'operation'].filter((field) => !data[field]);\n  const idempotencyKey = `${data.event_type || 'unknown'}:${data.record_id || 'missing'}`;\n  return {\n    json: {\n      ...data,\n      valid: missing.length === 0,\n      missing_fields: missing,\n      idempotency_key: idempotencyKey,\n      checked_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "validate-payload-demo",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "payload-valid-demo",
