    {
      "parameters": {
        "jsCode": "return items.map((item) => ({\n  json: {\n    status: 'duplicate_ignored',\n    event_id: item.json.event_id,\n    idempotency_key: item.json.idempotency_key,\n    message: 'Synthetic duplicate detected. No side effect was performed.'\n  }\n}));"
      },
